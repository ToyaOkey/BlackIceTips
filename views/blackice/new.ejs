<%- include('../partials/header.ejs')%>  
    <main>
       <div class="form-container">
        <h1>Sell Form</h1>
        <p>Fill out this form in order to sell a product. This will be reviewed by an expert.</p>
       
       <form action="/items" method = 'POST' enctype="multipart/form-data">
            <div class="row">
                <div class="column">
                    <label for="condition-dropdown">Condition</label>
                    <select name="condition-dropdown" id="condition-dropdown" required>
                        <option value="" disabled selected>Select a Condition</option>
                        <option value="Beginner">Beginner</option>
                        <option value="Intermediate">Intermediate</option>
                        <option value="Advanced">Advanced</option>
                        <option value="Expert">Expert</option>
                        <option value="Pro">Pro</option>
                    </select>
                </div>
                <div class="column">
                    <label for="price">Price</label>
                    <input type="number" id="price" name="price" placeholder="Enter price" min ="1"  max = "100" step =".01" required>
                </div>
            </div>
            <div class="row">
                <div class="column">
                    <label for="title">Title</label> 
                    <input type="text" id="title" name="title" placeholder="Enter product name" required>   
                </div>
                <!-- <div class="column">
                    <label for="seller">Seller</label> 
                    <input type="text" id="seller" name="seller" placeholder="Enter seller name" required>   
                </div> -->
            </div>
            <div class="row">
                <div class="column">
                    <label for="details">Details</label>
                    <textarea name="details" id="details" cols="40" rows="5" placeholder="Enter description" minlength="10" required></textarea>
                </div>
                <div class="column">
                    <label for="file-upload" class = "file-upload">Image</label>
                    <input type="file" id="file-upload" name="image" accept="image/*" required>
                </div>

            </div>
            <button>Submit</button>
       </form>
    </div>
    </main>
<%- include('../partials/footer.ejs')%>  
