<%- include('../partials/header.ejs')%>  
    <main>
      <!-- Items Section -->
      <% if(services.length > 0){ %>
        <h3 class = "center"> Select an item: </h3>
      <div class="wrapper">

          <% services.forEach( service => { %> 
            <a href="/items/<%= service.id%>">
              <div class="single-card">
                <div class="img-area">
                  <img src="<%= service.image%>" alt="<%= service.details %>" >
                </div>
                <div class="info">
                  <h3><%= service.title%></h3>
                  <p class="price">$<%= service.price%></p>
                  <p class="quality"><%= service.condition%></p>
                  <p class="offers"><%= service.offers%> Offers</p>
                </div>
              </div>
            </a>
          <% }); %> 
        <% } else { %>  
          <main>
            <div class="none-container">
                <h1 class = "center">Sorry there are no available items.</h1>
                <p class = "center">Have you considered AimLabs?</p>
            </div>
        </main>
        <% } %>

      </div>
    </main>
<%- include('../partials/footer.ejs')%>  