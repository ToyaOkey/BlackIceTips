<%- include('../partials/header.ejs')%>  
    <main>
       <div class="container">
        <div class="product-image">
            <img src="<%= service.image %>" alt="<%= service.details%>">
        </div>
      
       <div class="product-details">
        <header class="item-header">
            <h1 class="title"><%= service.title%></h1>
            <span class="condition">Condition: <%= service.condition%></span>
            <div class="price-offers">
                <p>PRICE</p>
                <!-- <span class="before"><$35></span> -->
                <span class="current">$<%= service.price %></span>
                <p class="item-offer"><%= service.offers%> OFFERS</p>
            </div>
        </header>   
            <article>
                <h5>
                    <%= service.details%>
                </h5>
            </article>
            <div class="seller">
                <h5>Seller: <%= service.seller%></h5>
            </div>
            <form action="" class="footer">
                <button type="submit" id = "edit-button" formmethod="GET" formaction="/items/<%= service.id%>/edit"><img src="../../images/edit-box-icon.svg" alt="edit icon">
                    Edit 
                </button>
                <button type="submit" id="delete-button" formmethod="POST" formaction="/items/<%= service.id%>?_method=DELETE"><img src="../../images/delete-button.svg" alt="delete icon" width ="25" height="25"> 
                    Delete
                </button>
            </form>
        </div>
       </div>
    </main>
<%- include('../partials/footer.ejs')%>  