<%- include('../partials/header.ejs')%>  
    <main>
       <div class="container">
        <div class="product-image">
            <img src="<%= service.image %>" alt="<%= service.details%>">
        </div>
      
       <div class="product-details">
        <header class="item-header">
            <h1 class="title"><%= service.title%></h1>
            <span class="condition">Condition: <%= service.condition%></span>
            <div class="price-offers">
                <p>PRICE</p>
                <!-- <span class="before"><$35></span> -->
                <span class="current">$<%= service.price %></span>
                <p class="item-offer"><%= service.totalOffers%> OFFERS</p>
                <p class="highest-offer">HIGHEST OFFER: $<%= service.highestOffer%></p>
            </div>
        </header>   
            <article>
                <h5>
                    <%= service.details%>
                </h5>
            </article>
            <div class="seller">
                <h5>Seller: <%= service.seller.firstName + " " + service.seller.lastName %></h5>
                
            </div>
            
                 <% if (service.active) { %>
                    <form action="/items/<%= service.id%>/offers" method = "POST" class="footer">
                        <input id = "offer-box" type="number" name= "amount" placeholder="Enter an offer" min="0.01" step = "0.01" required>
                    <button type="submit" id = "edit-button"><img src="../../images/edit-box-icon.svg" alt="edit icon">
                        Make Offer 
                    </button>
                <% } else { %> 
                    <p class="center red">This item is no longer active.</p>
                <% } %>

                <!-- <button type="submit" id="delete-button" formmethod="POST" formaction="/items/<%= service.id%>?_method=DELETE"><img src="../../images/delete-button.svg" alt="delete icon" width ="25" height="25"> 
                    Delete
                </button> -->
            </form>
        </div>
       </div>
    </main>
<%- include('../partials/footer.ejs')%>  