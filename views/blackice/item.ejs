<body>
    <header>
        <!-- <h1>Black Ice Tips</h1> -->
        <div class="img-container">
            <a href="index.html"><img src="images/Logo.svg" alt="Black Ice Tips Logo" id="logo"></a>
        </div>
        
        <div class="input-box">
            <input type="text" placeholder="search">
            
            <div class="search-container">
                <a href="#"><img src="images/search-icon.svg" alt="Search bar icon" id="search-icon" width="25" ></a>
            </div>
            
        </div>
        <nav>

            <ul>
                <li><a href ="items.html">Browse</a></li>
                <li><a href="new.html">Sell</a></li>
                <li id="login"><a href="#">Login</a></li>
                <li id="signup"><a href="#">Sign Up</a></li>
            </ul>
        </nav>
    </header>
    <main>
       <div class="container">
        <div class="product-image">
            <img src="images/coaching.svg" alt="Coaching big picture">
        </div>
      
       <div class="product-details">
        <header class="item-header">
            <h1 class="title">Black Ice Coaching</h1>
            <span class="condition">Condition: Beginner</span>
            <div class="price-offers">
                <p>PRICE</p>
                <span class="before">$35</span>
                <span class="current">$30</span>
                <p class="item-offer">5 offers</p>
            </div>
        </header>   
            <article>
                <h5>
                    This is premium one-on-one coaching for ranking up while looking for specific feedback on your skill.
                </h5>
            </article>
            <div class="seller">
                <h5>Seller: TooLazyToya</h5>
            </div>
            <div class="footer">
                <button type="button" id = "edit-button"><img src="images/edit-box-icon.svg" alt="edit icon">
                    Edit 
                </button>
                <button type="button" id="delete-button"><img src="images/delete-button.svg" alt="delete icon" width ="25" height="25"> 
                    Delete
                </button>
            </div>

        

        </div>
       </div>
