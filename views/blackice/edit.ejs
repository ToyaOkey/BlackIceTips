<%- include('../partials/header.ejs')%>  
    <main>
       <div class="form-container">
        <h1>Edit Form</h1>
        <p>You are currently editing.</p>
       
       <form method = "POST" action="/items/<%= service.id%>?_method=PUT" enctype="multipart/form-data">
            <div class="row">
                <div class="column">
                    <label for="condition-dropdown">Condition</label>
                    <select name="condition-dropdown" id="condition-dropdown" required>
                        <!-- <option value="<%=service.condition %>" disabled selected><%=service.condition %></option> -->
                        <option value="Beginner" <% if (service.condition === "Beginner") { %> selected <% } %>>Beginner</option>

                        <option value="Intermediate" <% if (service.condition === "Intermediate") { %> selected <% } %>>Intermediate</option>
                        
                        <option value="Advanced" <% if (service.condition === "Advanced") { %> selected <% } %>>Advanced</option>
                        
                        <option value="Expert" <% if (service.condition === "Expert") { %> selected <% } %>>Expert</option>
                        
                        <option value="Pro" <% if (service.condition === "Pro") { %> selected <% } %>>Pro</option>
                        
                        
                        <!-- <option value="Intermediate">Intermediate</option>
                        <option value="Advanced">Advanced</option>
                        <option value="Expert">Expert</option>
                        <option value="Pro">Pro</option> -->
                    </select>
                </div>
                <div class="column">
                    <label for="price">Price</label>
                    <input type="number" id="price" name="price" placeholder="Enter price" value="<%= service.price%>"  min = "1" step =".01" required>
                </div>
            </div>
            <div class="row">
                <div class="column">
                    <label for="title">Title</label> 
                    <input type="text" id="title" name="title" placeholder="Enter product name" value ="<%= service.title%>" required>   
                </div>
                <div class="column">
                    <label for="seller">Seller</label> 
                    <input type="text" id="seller" name="seller" placeholder="Enter seller name" value ="<%= service.seller%>" required>   
                </div>
            </div>
            <div class="row">
                <div class="column">
                    <label for="details">Details</label>
                    <textarea name="details" id="details" cols="40" rows="5" placeholder="Enter description" required><%= service.details%></textarea>
                </div>
                <div class="column">
                    <label for="file-upload" class = "file-upload">Image</label>
                    <input type="file" id="file-upload" name="image" accept="image/*" required>
                </div>

            </div>
            <button>Submit</button>
       </form>
    </div>
    </main>
    <%- include('../partials/footer.ejs')%>  
